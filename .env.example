# Container versions
N8N_VERSION=2.39.8
POSTGRES_VERSION=16-alpine

# Local application configuration
N8N_HOST_PORT=5678
N8N_HOST=localhost
N8N_PROTOCOL=http
N8N_EDITOR_BASE_URL=http://localhost:5678
WEBHOOK_URL=http://localhost:5678/
GENERIC_TIMEZONE=Europe/Istanbul
TZ=Europe/Istanbul

# PostgreSQL
POSTGRES_DB=n8n
POSTGRES_USER=n8n
POSTGRES_PASSWORD=replace_with_a_long_random_value

# Used by n8n to encrypt stored credentials
N8N_ENCRYPTION_KEY=replace_with_a_different_long_random_value

# Python API
PYTHON_VERSION=3.13
UV_VERSION=0.12.19
API_HOST_PORT=8000

# Investor application database
INVESTOR_DB=investor
INVESTOR_DB_USER=investor_app
INVESTOR_DB_PASSWORD=replace_with_a_long_random_value